<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nx_scout_nav</name>
  <version>0.1.0</version>
  <description>Scout autonomous flight (takeoff from the fixed pad, A to a wall point B, looming avoidance): thin ROS 2 adapter over the repo navigation/, localization/, avoidance/ and drivers/px4_scout/.</description>
  <maintainer email="ronrastorguev@gmail.com">Ron Rastorguev</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
